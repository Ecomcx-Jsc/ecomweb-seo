{
  "name": "Ecomcx SEO",
  "slug": "ecomcx-seo",
  "version": "1.2.3",
  "author": "Ecomcx",
  "description": "Tối ưu tìm kiếm toàn diện: tiêu đề & meta theo mẫu, chấm điểm nội dung theo từ khoá, schema JSON-LD, sitemap (thường, tin tức, video), chuyển hướng, theo dõi 404, breadcrumbs, SEO hình ảnh, IndexNow, Google Search Console, phân tích website và đối thủ.",
  "requires": {
    "cms": ">=1.4.0 <2.0.0"
  },
  "permissions": [
    "network"
  ],
  "backend": {
    "assembly": "backend/EcomcxSeo.dll",
    "entry": "EcomcxSeo.EcomcxSeoPlugin"
  },
  "admin": {
    "entry": "admin/index.js"
  },
  "frontend": {
    "entry": "frontend/index.tsx",
    "routes": [
      "/news-sitemap.xml",
      "/video-sitemap.xml",
      "/llms.txt",
      "/indexnow-key.txt"
    ]
  },
  "csp": {
    "script-src": [
      "https://www.googletagmanager.com"
    ],
    "connect-src": [
      "https://www.googletagmanager.com",
      "https://www.google-analytics.com",
      "https://*.google-analytics.com",
      "https://*.analytics.google.com"
    ],
    "frame-src": [
      "https://www.googletagmanager.com",
      "https://www.google.com"
    ]
  }
}
