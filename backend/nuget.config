<?xml version="1.0" encoding="utf-8"?>
<!-- Ecomweb.Plugin.Sdk: feed cục bộ của core (chạy core/ecomweb/scripts/pack-sdk.sh trước), hoặc GitHub Packages của Ecomcx-Jsc
     (dotnet nuget add source https://nuget.pkg.github.com/Ecomcx-Jsc/index.json -n ecomcx -u <user> -p <token>, đặt ở cấu hình máy, không ở đây) -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="ecomweb-core" value="../../../core/ecomweb/sdk/nuget" />
  </packageSources>
</configuration>
